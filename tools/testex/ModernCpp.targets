<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp14</LanguageStandard>
      <!-- Keep debug symbols in each object to avoid shared compiler PDB writes. -->
      <DebugInformationFormat Condition="'%(DebugInformationFormat)' == 'ProgramDatabase' Or '%(DebugInformationFormat)' == 'EditAndContinue'">OldStyle</DebugInformationFormat>
      <ProgramDataBaseFileName Condition="'%(DebugInformationFormat)' == 'OldStyle'" />
      <MinimalRebuild Condition="'%(DebugInformationFormat)' == 'OldStyle'">false</MinimalRebuild>
      <PreprocessorDefinitions>BOOST_ALL_NO_LIB;BOOST_USE_WINDOWS_H;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(VC_IncludePath);$(WindowsSDK_IncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>legacy_stdio_definitions.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
