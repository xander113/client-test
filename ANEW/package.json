{
  "name": "pot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pot Client and Pot Studio for desktop",
  "author": "Pot",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node build/setup.mjs",
    "dev": "vite",
    "build": "vite build",
    "start": "npm run start:client",
    "start:client": "npm run build && electron .",
    "start:studio": "npm run build && electron . --studio",
    "service:worlds": "node services/worlds/index.mjs",
    "service:render": "node services/render/index.mjs",
    "test": "node --test test/*.test.mjs",
    "package:client": "node build/package.mjs client",
    "package:studio": "node build/package.mjs studio",
    "package:desktop": "node build/package.mjs all"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "three": "0.187.0",
    "vite": "8.3.8"
  }
}
